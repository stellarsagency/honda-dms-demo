# Application
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000

# Database
DATABASE_URL=postgresql://dms:dms@localhost:5432/dms

# Redis / queues
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=replace-with-a-32-byte-random-string
JWT_REFRESH_SECRET=replace-with-another-32-byte-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Object storage (MinIO locally, Cloudflare R2 in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dms-documents
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_FORCE_PATH_STYLE=true

# Email (MailHog locally)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@honda-dms.local

# WhatsApp Business API
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# SMS gateway
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# FBR / tax
FBR_API_URL=
FBR_TOKEN=
FBR_POS_ID=

# Honda Atlas (confirm availability in discovery)
HONDA_API_BASE=
HONDA_API_KEY=
HONDA_DEALER_CODE=
